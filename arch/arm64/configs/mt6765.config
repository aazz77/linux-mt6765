# MT6765 bring-up config fragment
#
# Used together with arm64 defconfig:
#   make ARCH=arm64 LLVM=1 defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/mt6765.config
#   make ARCH=arm64 LLVM=1 olddefconfig
#
# Keeps the defconfig breadth but makes sure every block described in
# mt6765.dtsi actually has a driver compiled in.

# --- platform -------------------------------------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64=y
CONFIG_ARM_PSCI_FW=y
CONFIG_SMP=y

# --- clocks ---------------------------------------------------------------
CONFIG_COMMON_CLK_MT6765=y

# --- pinctrl / GPIO / EINT ------------------------------------------------
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MT6765=y
CONFIG_EINT_MTK=y

# --- timers ---------------------------------------------------------------
CONFIG_MTK_TIMER=y

# --- serial console -------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- PMIC / regulators ----------------------------------------------------
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6357=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y

# --- storage --------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y

# --- filesystems needed to mount a rootfs --------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_VFAT_FS=y

# --- Android userspace plumbing -------------------------------------------
# Enough to let a vendor Android init survive its first stage: binder,
# dma-buf heaps (the ION replacement) built in rather than modular, and
# SELinux.  /dev/ashmem and the vendor .ko modules are still unavailable
# on a 7.x kernel, so this only gets a vendor init past its first stage.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_LSM="lockdown,yama,selinux,bpf"
CONFIG_PSI=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y

# --- debug ----------------------------------------------------------------
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- pstore / ramoops: crash log survives reboot into stock Android ------
# Board DTS reserves the stock ram_console region (0x47c90000, 0xe0000);
# after `fastboot boot` + panic, Android 10 reads the mainline kernel log
# from /sys/fs/pstore/console-ramoops (or /proc/last_kmsg).
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
# Never build ramoops as a module: it must start before any storage.
# (defconfig may already enable PSTORE; these force built-in.)
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_FTRACE=n

# --- size trim -------------------------------------------------------------
# arm64 defconfig builds a 40MB raw Image (all SoC vendor drivers).  The
# stock vendor kernel decompresses to 25.3MB; LK's decompress buffer may
# reject larger images ("decompress kernel image fail").  Trim the big
# subsystems that bring-up (serial + mmc + pstore) does not need.
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_USB=n
CONFIG_USB_SUPPORT=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_RFKILL=n
CONFIG_ETHERNET=n
CONFIG_HID_SUPPORT=n
CONFIG_TOUCHSCREEN=n
CONFIG_MD=y
CONFIG_BLK_DEV_MD=n
CONFIG_MD_RAID0=n
CONFIG_MD_RAID1=n
CONFIG_MD_RAID10=n
CONFIG_MD_RAID456=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_VIDEO_DEV=n
CONFIG_MEDIA_CONTROLLER=n

# --- size trim round 2 -----------------------------------------------------
# LK reads the compressed kernel segment into a fixed buffer; the stock
# gz-dtb segment is 9.3MB and a 10.2MB segment fails decompress ("kernel
# image fail" even with a 22.9MB raw Image).  Keep compressed size well
# below 9.3MB: drop networking, tracing, BPF, modules, security plumbing
# (they can be re-added once the kernel boots).
CONFIG_NET=n
CONFIG_FTRACE=n
CONFIG_BPF_SYSCALL=n
CONFIG_BPF_JIT=n
CONFIG_KPROBES=n
CONFIG_KPROBE_EVENTS=n
CONFIG_UPROBES=n
CONFIG_SECCOMP=n
CONFIG_MODULES=n
CONFIG_IKCONFIG=n
CONFIG_IKCONFIG_PROC=n
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=n

# --- drop virt-platform firmware stacks ------------------------------------
# arm64 defconfig enables ARM SCMI/SCPI + TEE/OP-TEE + VIRTIO for QEMU virt.
# MT6765 has none of that firmware.  Besides wasting ~650 symbols, their
# platform drivers register devm/PM callbacks whose __exit code lives in
# .exit.text (inside __init_begin..__init_end).  free_initmem() vunmaps that
# whole range late in boot; an idle-task callback then jumped into the freed
# scmi_mailbox_driver_exit and faulted (ESR 0x96000047, level-3 translation
# fault) -> "Attempted to kill the idle task!".  Kill the whole stack.
CONFIG_ARM_SCMI_PROTOCOL=n
CONFIG_ARM_SCPI_PROTOCOL=n
CONFIG_ARM_SCMI_CPUFREQ=n
CONFIG_ARM_SCPI_CPUFREQ=n
CONFIG_COMMON_CLK_SCMI=n
CONFIG_COMMON_CLK_SCPI=n
CONFIG_SENSORS_ARM_SCMI=n
CONFIG_SENSORS_ARM_SCPI=n
CONFIG_REGULATOR_ARM_SCMI=n
CONFIG_PINCTRL_IMX_SCMI=n
CONFIG_ARM_SCMI_PM_DOMAIN=n
CONFIG_ARM_SCPI_PM_DOMAIN=n
CONFIG_TEE=n
CONFIG_OPTEE=n
CONFIG_HW_RANDOM_OPTEE=n
CONFIG_VIRTIO=n

# --- ARMv8.0 CPU: no Pointer Authentication --------------------------------
# MT6765 is Cortex-A53 (ARMv8.0); PAC (ARMv8.3) instructions such as
# paciasp/autiasp are not architecturally guaranteed on this core.  Turn the
# compiler feature off rather than relying on runtime alternatives patching.
CONFIG_ARM64_PTR_AUTH=n
CONFIG_ARM64_PTR_AUTH_KERNEL=n
CONFIG_ARM64_BTI=n
CONFIG_ARM64_BTI_KERNEL=n

# --- embedded initramfs ----------------------------------------------------
# The vendor DTB has no linux,initrd-start/end, so the LK-loaded ramdisk is
# invisible to mainline.  Embed our minimal busybox rootfs directly in the
# kernel image instead; populate_rootfs() unpacks it unconditionally.
# The .cpio.gz suffix makes usr/Makefile include it verbatim (no recompress).
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="board/x606f/initramfs/ramdisk.cpio.gz"
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
